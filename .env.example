# ========================================================
# TECHZU MULTI-OUTLET POS - CENTRAL ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env for local development or docker-compose.
# In production (GitHub Actions CI/CD to DigitalOcean), all variables
# are populated via GitHub Actions Secrets.

# --------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# --------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=pos_db
POSTGRES_PORT=5433

# Full Database Connection String
# Inside Docker Compose network, host is 'postgres:5432'
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/pos_db?schema=public

# --------------------------------------------------------
# 2. BACKEND CONFIGURATION (Express + Prisma 7)
# --------------------------------------------------------
BACKEND_PORT=5006
NODE_ENV=development
# Local dev: * or http://localhost:3004 | Production: https://pos-techzu.codernex.dev
CORS_ORIGIN=*

# --------------------------------------------------------
# 3. ADMIN FRONTEND CONFIGURATION (Vite + Tailwind v4 + RTK)
# --------------------------------------------------------
# Local dev: http://localhost:5006/api/v1
# Production: https://api-pos-techzu.codernex.dev/api/v1
VITE_API_BASE=http://localhost:5006/api/v1
ADMIN_PORT=3004

# --------------------------------------------------------
# 4. DIGITALOCEAN DROPLET DEPLOYMENT (GitHub Action Secrets)
# --------------------------------------------------------
# Production Domains:
# Frontend: https://pos-techzu.codernex.dev
# Backend:  https://api-pos-techzu.codernex.dev
#
# These variables should be stored in GitHub Repository Secrets:
# DROPLET_HOST=159.65.x.x
# DROPLET_USER=root
# DROPLET_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----..."
# DROPLET_SSH_PORT=22
# DEPLOY_DIR=/var/www/pos_techzu
# REPO_URL=https://github.com/your-org/pos_techzu.git
# SSL_EMAIL=admin@codernex.dev

